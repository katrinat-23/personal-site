---
interface Props {
  title: string;
  description: string;
  href: string;
  image?: string;
}

const { title, description, href, image } = Astro.props;
---

<a class="card" href={href}>
  {image && <img class="thumb" src={image} alt="" loading="lazy" />}
  <h3>{title}</h3>
  <p>{description}</p>
</a>

<style>
  .card {
    display: block;
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
  }

  .card:first-child {
    border-top: none;
  }

  .thumb {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    border-radius: 0.5rem;
    margin-bottom: 0.75rem;
    border: 1px solid var(--color-border);
  }

  .card h3 {
    margin: 0 0 0.25rem;
    font-size: 1.05rem;
  }

  .card p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .card:hover h3 {
    text-decoration: underline;
  }
</style>

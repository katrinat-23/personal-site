---
interface Props {
  title: string;
  description: string;
  href: string;
  image?: string;
}

const { title, description, href, image } = Astro.props;
---

<a class="card" href={href}>
  {image && <img class="thumb" src={image} alt="" loading="lazy" />}
  <div class="text">
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
</a>

<style>
  .card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
  }

  .card:first-child {
    border-top: none;
  }

  .thumb {
    width: 5.5rem;
    height: 5.5rem;
    object-fit: cover;
    border-radius: 0.5rem;
    flex-shrink: 0;
  }

  .text {
    min-width: 0;
  }

  .card h3 {
    margin: 0 0 0.25rem;
    font-size: 1.05rem;
  }

  .card p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .card:hover h3 {
    text-decoration: underline;
  }
</style>
